import gradio as gr

faqs = {
    "What is Artificial Intelligence?":
        "Artificial Intelligence (AI) is the ability of machines to perform tasks that normally require human intelligence.",

    "What is Machine Learning?":
        "Machine Learning is a branch of AI where computers learn patterns from data and make predictions.",

    "What is Python?":
        "Python is a popular programming language used for AI, web development, automation and data science.",

    "What is NLP?":
        "NLP stands for Natural Language Processing. It helps computers understand and process human language.",

    "What is a Chatbot?":
        "A chatbot is a software application that communicates with users and provides automated responses.",

    "What is Deep Learning?":
        "Deep Learning is a type of machine learning that uses neural networks with multiple layers.",

    "What is Data Science?":
        "Data Science is the process of collecting, analyzing and interpreting data to find useful information.",

    "What is Computer Vision?":
        "Computer Vision is a field of AI that helps computers understand images and videos.",

    "What is an Algorithm?":
        "An algorithm is a step-by-step procedure used to solve a problem or perform a task.",

    "What is GitHub?":
        "GitHub is a platform used to store, manage and share source code and software projects."
}

def show_answer(question):
    return faqs[question]

with gr.Blocks(title="FAQ Chatbot") as demo:

    gr.Markdown(
        """
        # 🤖 FAQ Chatbot
        ### Frequently Asked Questions
        Click on a question to see its answer.
        """
    )

    question_dropdown = gr.Dropdown(
        choices=list(faqs.keys()),
        label="Select a Question",
        value=list(faqs.keys())[0]
    )

    answer_box = gr.Textbox(
        label="Answer",
        lines=5
    )

    submit_button = gr.Button("Show Answer")

    submit_button.click(
        fn=show_answer,
        inputs=question_dropdown,
        outputs=answer_box
    )

    gr.Markdown(
        """
        ---
        **AI FAQ Chatbot | Built with Python and Gradio**
        """
    )

demo.launch(share=True)